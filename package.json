{
  "name": "my-app",
  "version": "1.0.0",
  "description": "Production-ready Node.js API with Docker + GitLab CI/CD",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint server.js app/",
    "healthcheck": "node -e \"require('http').get('http://localhost:'+(process.env.PORT||3000)+'/health',r=>process.exit(r.statusCode===200?0:1))\""
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["docker", "gitlab", "ci-cd", "express", "api"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9"
  }
}
